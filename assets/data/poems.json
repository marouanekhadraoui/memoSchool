[
  {
    "id": 1,
    "level": 1,
    "lines": [
      "صديقُ المرءِ يُسعدُ في الشدائدِ",
      "وَيُخفي السّرَّ إن ظهرتْ حقائدهْ",
      "فمن يلقَ الوفاءَ بغيرِ كيدٍ",
      "يَعِشْ في العزِّ والدنيا تُوافقهْ"
    ],
    "keywords": ["صديق", "وفاء", "شدائد", "عز", "سر"],
    "topic": "الصداقة"
  },
  {
    "id": 2,
    "level": 1,
    "lines": [
      "إذا ما هِمتَ في طلبِ المعالي",
      "فَصَابِرْ إنما النصرُ مع الصابرِ",
      "ولا تيأسْ من الفشلِ المُوالي",
      "فبعدَ العسرِ يأتي اليسرُ ظهرِ"
    ],
    "keywords": ["همة", "معالي", "صبر", "نصر", "عسر", "يسر"],
    "topic": "العزيمة"
  },
  {
    "id": 3,
    "level": 1,
    "lines": [
      "* العلمُ نورٌ والجهلُ ظلامُ *",
      "* بالحلمِ ترقى وبهِ القوامُ *",
      "* تعلمْ فما المالُ بلا علمٍ * ",
      "* كجسمٍ بلا روحٍ يُسامُ *"
    ],
    "keywords": ["علم", "جهل", "نور", "ظلام", "حلم", "مال", "روح"],
    "topic": "العلم"
  },
  {
    "id": 4,
    "level": 2,
    "lines": [
      "صبرُ الكريمِ على الأذى فضلُ",
      "والجهلُ يفضحُ من به خبلُ",
      "فاصبرْ على دهْرٍ يمرُّ بجورِ",
      "فالصبرُ مفتاحُ الفرجِ المباحِ",
      "من ذاقَ مرَّ الصبرِ يوماً",
      "حلا له العيشُ بغيرِ جناحِ"
    ],
    "keywords": ["صبر", "كريم", "أذى", "جهل", "دهر", "فرج", "عيش"],
    "topic": "الصبر"
  },
  {
    "id": 5,
    "level": 2,
    "lines": [
      "إذا طلبتَ العلى فاهجرْ دناءهْ",
      "واركبْ صعابَ المجدِ دونَ عناءِ",
      "فالنجمُ لا يرقى له من سهاهْ",
      "والسيفُ لا يلمعُ إلا في الدماءِ",
      "فلا تقنعْ بغيرِ الذروةِ العليا",
      "فالعمرُ فرصةٌ والعزُّ غذاءِ"
    ],
    "keywords": ["على", "مجد", "نجم", "سيف", "عز", "فرصة", "قناعة"],
    "topic": "الطموح"
  },
  {
    "id": 6,
    "level": 2,
    "lines": [
      "الصدقُ تاجُ المرءِ في كلِّ الورى",
      "والكذبُ يفضحُ صاحبَه حيثُ انتهى",
      "فكنْ صادقاً إن الحياةُ قصيرةٌ",
      "والصدقُ يبني والكذبُ يهدمُ ما بنى",
      "والمرءُ يبقى ما بقى صادقاً",
      "والكاذبُ يمحى كالسرابِ إذا غنى"
    ],
    "keywords": ["صدق", "كذب", "تاج", "فضيحة", "حياة", "بناء", "سراب"],
    "topic": "الصدق"
  },
  {
    "id": 7,
    "level": 3,
    "lines": [
      "العدلُ أساسُ المُلكِ والدينِ",
      "به تسودُ الأممُ والأرضُ تبني",
      "فلا تظلمَنْ مهما قويتَ فإنَّ",
      "الظلمَ مرتعهُ وخيمُ المنى",
      "والحقُّ يعلو لا يُواريهِ الهوى",
      "والظلمُ يصرعُ أهلهُ حيثُ انتهى",
      "فكنْ قواماً بالقسطِ يا هذا"
    ],
    "keywords": ["عدل", "ملك", "ظلم", "حق", "قسط", "أمة", "أرض"],
    "topic": "العدل"
  },
  {
    "id": 8,
    "level": 3,
    "lines": [
      "الكرمُ يبني ذكرَ صاحبهِ على الدهرِ",
      "والبخلُ يهدمُ ما بنى من قبلِ البشرِ",
      "فإن كنتَ ذا مالٍ فجوْدُك زينُهُ",
      "وإن كنتَ فقيراً فالقنوعُ هو الخيرُ",
      "ليس الغنى عن كثرةِ الأموالِ",
      "إنما الغنى غنى النفسِ في الحالِ",
      "فالعطاءُ سرُّ السعادةِ لا المالُ"
    ],
    "keywords": ["كرم", "بخل", "ذكر", "مال", "غنى", "نفس", "عطاء", "سعادة"],
    "topic": "الكرم"
  },
  {
    "id": 9,
    "level": 3,
    "lines": [
      "الحكمةُ نورٌ يضيءُ دروبَ الحياةْ",
      "والجهلُ ظلمةٌ تردي إلى الهاويةْ",
      "فاستنطقِ العقلَ ولا تتبعِ الهوى",
      "فالعقلُ أستاذٌ ونعمَ الهادي هيهْ",
      "من كان حكيماً نالَ كلَّ مرادهِ",
      "ومن كان أحمقاً عاشَ في الشقاوةْ",
      "فالحلمُ زينٌ والعجلةُ شينٌ أبداً"
    ],
    "keywords": ["حكمة", "نور", "عقل", "هوى", "حلم", "عجلة", "شقاوة"],
    "topic": "الحكمة"
  },
  {
    "id": 10,
    "level": 4,
    "lines": [
      "الحبُّ سِحرٌ يملأُ الأكوانَ نورا",
      "فيهِ نعيمُ الروحِ والحسُّ يطيرا",
      "ولكنْ إذا ما خانَ صارَ جحيما",
      "فاخترْ حبيباً لا يخونُ إذا ظهرا",
      "ليس الحبُّ كلمةً تُقالُ",
      "بل حبُّك العطاءُ والصبرُ الطويلُ",
      "والحبُّ يبني المجدَ أو يهدمُ الجيلا",
      "فكنْ على حذرٍ إذا أردتَ الهوى"
    ],
    "keywords": ["حب", "روح", "خيانة", "عطاء", "صبر", "مجد", "هوى", "حذر"],
    "topic": "الحب"
  },
  {
    "id": 11,
    "level": 4,
    "lines": [
      "الشجاعةُ تاجُ الفتى في الملماتِ",
      "والجبنُ يفضحُ صاحبَه في النائباتِ",
      "فاركبْ أهوالَ الخطرِ دونَ ترددٍ",
      "فالبحرُ لا يخاضُ بلا مخاطراتِ",
      "والسيفُ لا يقطعُ إلا في الضرباتِ",
      "والعزُّ يبنى فوقَ هامِ الساداتِ",
      "لا خيرَ فيمنْ يخافُ من صفعاتِ",
      "والموتُ كأسُ الماجدينَ إذا انتهى"
    ],
    "keywords": ["شجاعة", "جبن", "خطر", "بحر", "سيف", "عز", "موت", "مجد"],
    "topic": "الشجاعة"
  },
  {
    "id": 12,
    "level": 4,
    "lines": [
      "الوقتُ سيفٌ إن لم تقطعهُ قطعَكْ",
      "والعمرُ أيامٌ تمرُّ سريعةً كلمحِ البصرْ",
      "فاغتنمِ الوقتَ قبلَ أن يفوتَكْ",
      "فكلُّ يومٍ ليس يعودُ أبداً إلى البشرْ",
      "والساعةُ الضائعةُ لا تعوّضُ أبداً",
      "والفرصةُ إن ولتْ فعسرُ الظفرْ",
      "فلا تؤجلْ عملَ اليومِ إلى غدِ",
      "فالغدُ قد لا يأتي ونادمَ العمرْ"
    ],
    "keywords": ["وقت", "عمر", "سيف", "فرصة", "ندم", "تأجيل", "غد", "ساعة"],
    "topic": "الوقت"
  },
  {
    "id": 13,
    "level": 5,
    "lines": [
      "قضاءُ اللهِ يجري لا مردَّ لهُ",
      "فلا تسألْ لماذا جاءَ أو ماذا دهى",
      "فالدهرُ دولٌ والأيامُ عبرةٌ",
      "وصبرُ المؤمنِ يمحو كلَّ ما قد جرى",
      "والمقدورُ يأتي ولو أبى الناسُ كلهم",
      "فارضَ بقسمتِك ترتاحْ من العناءِ",
      "والموتُ حقٌّ فما الحياةُ بباقيةٍ",
      "فاستعدْ للرحيلِ قبلَ فواتِ الوقتِ",
      "والخيرُ والشرُّ ابتلاءٌ من العلى",
      "فاشكرْ على كلٍّ تكنْ من الفائزينْ"
    ],
    "keywords": ["قضاء", "قدر", "دهر", "صبر", "موت", "حياة", "ابتلاء", "شكر", "رضا"],
    "topic": "القدر"
  },
  {
    "id": 14,
    "level": 5,
    "lines": [
      "الحياةُ كالبحرِ موجٌ فوقَ أمواجِ",
      "فطوراً صفاءٌ وأحياناً شظفُ العاجِ",
      "فلا تيأسْ إذا اشتدَّ البلاءُ بكَ",
      "فبعدَ الغيمِ يشرقُ النورُ الناجي",
      "والأملُ خيرُ زادٍ للمرءِ في سفرهِ",
      "فامضِ قدماً ولو كانت به السُّبُلُ عاجي",
      "والعمرُ صفحةٌ تكتبُها بأفعالِك",
      "فاكتبْ جميلاً يبقى بعدَ مماتِك",
      "لا خيرَ في عيشٍ بلا هدفٍ سامي",
      "فارفعْ رأسَك واصنعْ مجدَ حياتِك"
    ],
    "keywords": ["حياة", "بحر", "بلاء", "أمل", "صبر", "هدف", "مجد", "سفر", "كتابة", "بقاء"],
    "topic": "الحياة"
  },
  {
    "id": 15,
    "level": 5,
    "lines": [
      "الموتُ ليس نهايةً بل بدايةُ الأبدْ",
      "فلا تخفْ من رحيلٍ هو فوزٌ بالخلدْ",
      "والدنيا جسرٌ فاعبرْ ولا تبنِ عليها",
      "فمن بنى على الماءِ غداً سيقعُ في الردى",
      "وذكرُ الفتى بعدَ الموتِ هو الحياةُ",
      "فخلّفْ أثراً يبقى على مرِّ السنينْ",
      "واختمْ بخيرٍ فإنَّ الخاتمةَ هي البقاءْ",
      "وكلُّ نفسٍ ذائقةُ الموتِ لا محالةْ",
      "فاستعدْ للقاءِ اللهِ بالعملِ الصالحِ",
      "تربحْ جنانَ الخلدِ والفردوسَ الأعلى"
    ],
    "keywords": ["موت", "خلود", "دنيا", "ذكر", "أثر", "خاتمة", "لقاء الله", "عمل صالح", "جنة", "فردوس"],
    "topic": "الموت والخلود"
  }
]